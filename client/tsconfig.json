{
	"compilerOptions": {
		"target": "ES2024",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"lib": [
			"ES2024",
			"DOM"
		],
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"erasableSyntaxOnly": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"types": [
			"node"
		],
		"typeRoots": [
			"../server/node_modules/@types"
		]
	},
	"include": [
		"src",
		"test"
	]
}
