+    /// tau: where a selection's knob dragged to `point` goes, as a text view's: the nearest line with text in it (not
+    /// the blank line of a paragraph's gap), and on it the boundary between two characters nearest the point, before
+    /// the line's trailing spaces and break.
+    public func caretIndex(at point: CGPoint) -> Int? {
+        guard let attributedString = self.attributedString else {
+            return nil
+        }
+        let string = attributedString.string as NSString
+        let transformedPoint = CGPoint(x: point.x - self.insets.left, y: point.y - self.insets.top)
+        var closest: (line: InteractiveTextNodeLine, frame: CGRect, range: NSRange, end: Int, isBlank: Bool, distance: CGFloat)?
+        for segment in self.segments {
+            for line in segment.lines.prefix(segment.visibleLineCount) {
+                guard let range = line.range, range.length > 0 else {
+                    continue
+                }
+                var end = min(range.upperBound, string.length)
+                while end > range.location, let scalar = UnicodeScalar(string.character(at: end - 1)), CharacterSet.whitespacesAndNewlines.contains(scalar) {
+                    end -= 1
+                }
+                let isBlank = end == range.location
+                var lineFrame = line.frame
+                switch self.resolvedAlignment {
+                case .center:
+                    lineFrame.origin.x = floor((self.size.width - lineFrame.size.width) / 2.0)
+                case .natural, .left:
+                    lineFrame = displayLineFrame(frame: lineFrame, isRTL: line.isRTL, boundingRect: CGRect(origin: CGPoint(), size: self.size), cutout: self.cutout)
+                case .right:
+                    lineFrame.origin.x = self.size.width - lineFrame.size.width
+                default:
+                    break
+                }
+                let distance = max(0.0, lineFrame.minY - transformedPoint.y, transformedPoint.y - lineFrame.maxY)
+                if let current = closest {
+                    // A line with text wins over a blank one, then the nearer one.
+                    if current.isBlank == isBlank ? distance >= current.distance : isBlank {
+                        continue
+                    }
+                }
+                closest = (line, lineFrame, range, end, isBlank, distance)
+            }
+        }
+        guard let (line, lineFrame, range, end, _, _) = closest else {
+            return nil
+        }
+        let x = transformedPoint.x - lineFrame.minX
+        if !line.isRTL {
+            if x <= 0.0 {
+                return range.location
+            }
+            if x >= CTLineGetOffsetForStringIndex(line.line, end, nil) {
+                return end
+            }
+        }
+        let index = CTLineGetStringIndexForPosition(line.line, CGPoint(x: x, y: 0.0))
+        if index == kCFNotFound {
+            return range.location
+        }
+        return max(range.location, min(end, index))
+    }
