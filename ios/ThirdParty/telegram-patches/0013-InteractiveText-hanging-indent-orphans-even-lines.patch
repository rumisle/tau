+// first line's offset, then the other lines'.
+public let interactiveTextIndentKey = NSAttributedString.Key("Attribute__Indent")
+// tau: text whose paragraphs do not end on a line with a single Han character.
+public let interactiveTextAvoidsOrphansKey = NSAttributedString.Key("Attribute__AvoidsOrphans")
+
+private func isHanCharacter(_ c: unichar) -> Bool {
+    return (c >= 0x4E00 && c <= 0x9FFF) || (c >= 0x3400 && c <= 0x4DBF) || (c >= 0xF900 && c <= 0xFAFF)
+}
+
+/// A line with one Han character and, besides punctuation and spaces, nothing else.
+private func isOrphanLine(_ string: NSString, _ range: NSRange) -> Bool {
+    var han = 0
+    for index in range.location ..< range.location + range.length {
+        let c = string.character(at: index)
+        if isHanCharacter(c) {
+            han += 1
+        } else if c > 0x7F && !(c >= 0x3000 && c <= 0x303F) && !(c >= 0xFF00 && c <= 0xFF65) && !(c >= 0x2000 && c <= 0x206F) {
+            return false
+        } else if c <= 0x7F && ((c >= 0x30 && c <= 0x39) || (c >= 0x41 && c <= 0x5A) || (c >= 0x61 && c <= 0x7A)) {
+            return false
+        }
+    }
+    return han == 1
+}
+
+/// How many characters the line before an orphan gives the last line: its last Han character, with the punctuation
+/// after it, which cannot start a line, and an opening bracket before it, which cannot end one. Nil when that would be
+/// all of the line, or a break inside other text.
+private func orphanPullCount(_ string: NSString, _ range: NSRange) -> Int? {
+    let noStart: Set<unichar> = Set("，。、：；！？）」』》〉】〕”’…—·".utf16)
+    let noEnd: Set<unichar> = Set("（「『《〈【〔“‘".utf16)
+    let end = range.location + range.length
+    var count = 1
+    while count < range.length, noStart.contains(string.character(at: end - count)) {
+        count += 1
+    }
+    guard count < range.length, isHanCharacter(string.character(at: end - count)) else {
+        return nil
+    }
+    while count + 1 < range.length, noEnd.contains(string.character(at: end - count - 1)) {
+        count += 1
+    }
+    return count < range.length ? count : nil
+}
