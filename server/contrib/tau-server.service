# tau's server as a systemd user unit: cp to ~/.config/systemd/user/, set your own in ExecStart (the model, and for
# Apple's pushes your APNs key's ID and your team's ID in place of KEYID and TEAMID, or drop those two options), then
#   systemctl --user daemon-reload && systemctl --user enable --now tau-server
#   loginctl enable-linger $USER   # from boot, without logging in
# Clients need the token in ~/.config/tau/token (only the owner may read it; the server will not start beyond loopback
# without one):
#   umask 077 && mkdir -p ~/.config/tau && openssl rand -hex 32 > ~/.config/tau/token
# and Apple's pushes the account's APNs key beside it (AuthKey_<key id>.p8, chmod 600), with the team's ID.
# The code is ~/tau (rsync'd, replaceable); the data, which only its owner may enter, ~/.local/share/tau.
# Through a login, interactive zsh, so the server, and every command its agents and their skills run, has a fresh
# terminal's environment (API keys set in ~/.zshrc), less systemd's own variables. OPENAI_API_KEY is unset so pi-ai
# uses the ChatGPT login for OpenAI models.
[Unit]
Description=tau server
After=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=%h/tau/server
ExecStart=/bin/zsh -lic 'unset INVOCATION_ID JOURNAL_STREAM MANAGERPID MANAGERPIDFDID SYSTEMD_EXEC_PID MEMORY_PRESSURE_WATCH MEMORY_PRESSURE_WRITE OPENAI_API_KEY; exec node --no-warnings src/main.ts --data %h/.local/share/tau --model anthropic/claude-haiku-5-5 --host 0.0.0.0 --token-file %h/.config/tau/token --apns-key %h/.config/tau/AuthKey_KEYID.p8 --apns-team TEAMID'
StandardInput=null
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
