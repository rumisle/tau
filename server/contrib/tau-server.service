# tau's server as a systemd user unit: cp to ~/.config/systemd/user/, then
#   systemctl --user daemon-reload && systemctl --user enable --now tau-server
#   loginctl enable-linger $USER   # from boot, without logging in
# Clients need the token in ~/.config/tau/token (only the owner may read it; the server will not start beyond loopback
# without one):
#   umask 077 && mkdir -p ~/.config/tau && openssl rand -base64 32 | tr -d '\n=' | tr '+/' '-_' > ~/.config/tau/token
# Through a login, interactive zsh, so the server, and every command its agents and their skills run, has a fresh
# terminal's environment (API keys set in ~/.zshrc), less systemd's own variables. OPENAI_API_KEY is unset so pi-ai
# uses the ChatGPT login for OpenAI models.
[Unit]
Description=tau server
After=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=%h/tau/server
ExecStart=/bin/zsh -lic 'unset INVOCATION_ID JOURNAL_STREAM MANAGERPID MANAGERPIDFDID SYSTEMD_EXEC_PID MEMORY_PRESSURE_WATCH MEMORY_PRESSURE_WRITE OPENAI_API_KEY; exec node --no-warnings src/main.ts --db %h/tau/data/tau.db --model anthropic/claude-haiku-5-5 --cwd %h --host 0.0.0.0 --token-file %h/.config/tau/token'
StandardInput=null
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
